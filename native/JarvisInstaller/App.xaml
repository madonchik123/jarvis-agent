<Application x:Class="JarvisInstaller.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#38D6FF" />
    <SolidColorBrush x:Key="Text" Color="#EAF4FF" />
    <SolidColorBrush x:Key="Muted" Color="#8FA3BA" />
    <FontFamily x:Key="Head">Segoe UI Variable Display Semibold, Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="Body">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- primary button: glowing cyan pill -->
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="#031018" />
      <Setter Property="FontFamily" Value="{StaticResource Head}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="34,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="24" Padding="{TemplateBinding Padding}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#5BE3FF" Offset="0" />
                  <GradientStop Color="#2CB8F5" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Border.Effect>
                <DropShadowEffect x:Name="glow" Color="#38D6FF" BlurRadius="26" ShadowDepth="0" Opacity="0.55" />
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="RenderTransform">
                  <Setter.Value>
                    <ScaleTransform ScaleX="1.03" ScaleY="1.03" />
                  </Setter.Value>
                </Setter>
                <Setter TargetName="b" Property="RenderTransformOrigin" Value="0.5,0.5" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- secondary button: outlined -->
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontFamily" Value="{StaticResource Body}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="20,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="20" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="#3338D6FF" Background="#14FFFFFF">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#2238D6FF" />
                <Setter TargetName="b" Property="BorderBrush" Value="#8838D6FF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- title-bar glyph buttons -->
    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="8" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#22FFFFFF" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- toggle-style checkbox -->
    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontFamily" Value="{StaticResource Body}" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="track" Width="34" Height="18" CornerRadius="9" Background="#26FFFFFF" VerticalAlignment="Center">
                <Ellipse x:Name="dot" Width="12" Height="12" Fill="#AFC2D6" HorizontalAlignment="Left" Margin="3,0,0,0" />
              </Border>
              <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#38D6FF" />
                <Setter TargetName="dot" Property="Fill" Value="#031018" />
                <Setter TargetName="dot" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="dot" Property="Margin" Value="0,0,3,0" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
